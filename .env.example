# Bu dosya yalnızca boş/temsili değerler içerir. Gerçek sırları .env.local veya dağıtım ortamında tutun.

# Site
NEXT_PUBLIC_SITE_URL=https://almanya101.de
NEXT_PUBLIC_SITE_NAME=Almanya101

# Supabase: tarayıcıda kullanılabilen proje bilgileri
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# Supabase: sunucu/Edge Function sırları; NEXT_PUBLIC_ öneki eklemeyin
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Yönetici ve kullanıcı erişimi
ADMIN_PANEL_PASSWORD=
CORNER_ADMIN_PASSWORD=
DEVUSER_AUTH_SECRET=
IP_HASH_SALT=

# Veritabanı bağlantısı yalnızca sunucu/bakım işlemleri için
DIRECT_CONNECTION_STRING=
DB_PASSWORD=

# Haber hattı
NEWS_PIPELINE_SECRET=
GEMINI_API_KEY=
THENEWSAPI_TOKEN=

# İsteğe bağlı harici servisler
GOOGLE_PLACES_API_KEY=
TAVILY_API_KEY=
SERPAPI_API_KEY=
SERVICE_FINDER_SECRET=

# NODE_ENV uygulama çalışma biçimince belirlenir; bu şablonda tanımlanmaz.
