# Admin & Auth
ADMIN_PANEL_PASSWORD=your_admin_panel_password
CORNER_ADMIN_PASSWORD=your_corner_admin_password
DEVUSER_AUTH_SECRET=your_devuser_auth_secret
IP_HASH_SALT=your_ip_hash_salt

# Google
GOOGLE_PLACES_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_supabase_publishable_key
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_KEY=your_supabase_service_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Database
DIRECT_CONNECTION_STRING=postgresql://postgres:your_db_password@db.your-project.supabase.co:5432/postgres
DB_PASSWORD=your_db_password

# News Pipeline (news-ingest edge function)
# Admin API rotaları ile edge function arasındaki paylaşılan gizli anahtar
# (Supabase secrets ile aynı olmalı).
NEWS_PIPELINE_SECRET=your_news_pipeline_secret
# Gemini: AI taslak üretimi (news_pipeline_settings.ai_enabled = true ise kullanılır)
GEMINI_API_KEY=your_gemini_api_key
# TheNewsAPI: source_type='api' kaynakları için
THENEWSAPI_TOKEN=your_thenewsapi_token

# Harici araştırma API'leri (service-finder / opsiyonel)
TAVILY_API_KEY=your_tavily_api_key
SERPAPI_API_KEY=your_serpapi_api_key

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://almanya101.de
NEXT_PUBLIC_SITE_NAME=Almanya101

# Runtime
NODE_ENV=production
